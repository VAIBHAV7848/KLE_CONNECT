# ============================================================
# KLE CONNECT — Environment Variables Template
# Copy this file to .env and fill in your values
# ============================================================

# Supabase Configuration (REQUIRED)
# Get these from: https://supabase.com/dashboard → your project → Settings → API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_publishable_api_key

# Agora Video Call Configuration (Optional - for Study Rooms)
VITE_AGORA_APP_ID=
VITE_TOKEN_SERVER_URL=

# AI Configuration (Optional - for AI Tutor)
# Option 1: Direct Analytics Engine API (Recommended for dev)
VITE_GEMINI_API_KEY=

# Option 2: Proxy Server (Recommended for production)
# VITE_AI_API_URL=https://your-vercel-app.vercel.app/api/ai

# Admin Configuration (Optional)
# These emails will be granted super_admin role automatically
VITE_PLATFORM_OWNER_EMAIL=
VITE_SECONDARY_ADMIN_EMAIL=
VITE_MASTER_ADMIN_PASSWORD=
