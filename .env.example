# Agora Video Call Configuration
VITE_AGORA_APP_ID=bb21d68abe3449f9b90944ee33253fa5

# Token Server URL (Render deployment)
# For production, set this in Vercel dashboard to your Render URL
# Example: https://kle-token-server.onrender.com
VITE_TOKEN_SERVER_URL=

# AI API URL for Local Development
# When running locally (npm run dev), set this to your deployed Vercel URL
# This allows local frontend to use the deployed /api/ai endpoint with dynamic providers
# Example: https://kle-connect.vercel.app/api/ai
# Leave empty for production (uses relative "/api/ai")
VITE_AI_API_URL=

# Firebase Configuration (already in code, no need to set here)
# These are public and safe to commit
