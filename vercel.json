{
    "headers": [
        {
            "source": "/(.*)",
            "headers": [

                {
                    "key": "X-Frame-Options",
                    "value": "SAMEORIGIN"
                },
                {
                    "key": "X-Content-Type-Options",
                    "value": "nosniff"
                },
                {
                    "key": "Referrer-Policy",
                    "value": "strict-origin-when-cross-origin"
                },
                {
                    "key": "Permissions-Policy",
                    "value": "camera=(self), microphone=(self), geolocation=()"
                }
            ]
        }
    ],
    "env": {
        "VITE_AGORA_APP_ID": "bb21d68abe3449f9b90944ee33253fa5"
    }
}