{
    "rules": {
        "users": {
            ".read": "root.child('users').child(auth.uid).child('role').val() === 'super_admin' || root.child('users').child(auth.uid).child('role').val() === 'ops_admin'",
            "$uid": {
                ".read": "auth != null",
                ".write": "$uid === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'super_admin'"
            }
        },
        "doubts": {
            ".read": "auth != null",
            ".write": "auth != null"
        },
        "community": {
            ".read": "auth != null",
            ".write": "auth != null"
        },
        "notes": {
            ".read": "auth != null",
            ".write": "auth != null"
        },
        "system": {
            "lockdown": {
                ".read": true,
                ".write": "root.child('users').child(auth.uid).child('role').val() === 'super_admin'"
            }
        }
    }
}