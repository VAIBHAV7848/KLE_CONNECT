{
    "rules": {
        "users": {
            ".read": "auth.uid != null && (root.child('users').child(auth.uid).child('role').val() === 'super_admin' || root.child('users').child(auth.uid).child('role').val() === 'ops_admin')",
            "$uid": {
                ".read": "auth != null",
                ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'super_admin' || ($uid === auth.uid && ((!data.exists() && newData.child('role').val() === 'user' && !newData.hasChild('isOwner')) || (data.exists() && newData.child('role').val() === data.child('role').val() && (!newData.hasChild('isOwner') || newData.child('isOwner').val() === data.child('isOwner').val())))))"
            }
        },
        "system_config": {
            ".read": "auth.uid != null && root.child('users').child(auth.uid).child('isOwner').val() === true",
            ".write": "auth.uid != null && root.child('users').child(auth.uid).child('isOwner').val() === true"
        },
        "forum": {
            ".read": "auth != null",
            "$questionId": {
                ".write": "auth != null && (!data.exists() || data.child('authorId').val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'super_admin')",
                ".validate": "newData.hasChildren(['question', 'subject', 'author'])"
            }
        },
        "community": {
            ".read": "auth != null",
            ".write": "auth != null"
        },
        "notes": {
            ".read": "auth != null",
            "$noteId": {
                ".write": "auth != null && (!data.exists() || data.child('uploaderId').val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'super_admin')"
            }
        },
        "rooms": {
            ".read": "auth != null",
            "$roomId": {
                ".write": "auth != null && (!data.exists() || data.child('hostId').val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'super_admin')"
            }
        },
        "system": {
            "lockdown": {
                ".read": true,
                ".write": "root.child('users').child(auth.uid).child('role').val() === 'super_admin'"
            },
            "broadcast": {
                ".read": true,
                ".write": "root.child('users').child(auth.uid).child('role').val() === 'super_admin' || root.child('users').child(auth.uid).child('role').val() === 'ops_admin'"
            },
            "maintenance": {
                ".read": true,
                ".write": "root.child('users').child(auth.uid).child('role').val() === 'super_admin'"
            },
            "audit_logs": {
                ".read": "root.child('users').child(auth.uid).child('role').val() === 'super_admin'",
                "$logId": {
                    ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'super_admin' && !data.exists()",
                    ".validate": "newData.hasChildren(['action', 'timestamp', 'actorId']) && newData.child('actorId').val() === auth.uid"
                }
            }
        }
    }
}